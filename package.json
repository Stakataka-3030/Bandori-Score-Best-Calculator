{
  "name": "bandori-score-best-calculator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test:shuffle": "node scripts/verify-skill-shuffle.mjs",
    "test:scheduler": "node scripts/verify-skill-trigger-scheduler.mjs",
    "build:web": "npm run typecheck && vite build",
    "build": "npm run test:shuffle && npm run test:scheduler && npm run build:web",
    "preview": "vite preview",
    "vendor:hhwx": "node scripts/vendor-hhwx.mjs",
    "vendor:hhwx:check": "node scripts/vendor-hhwx.mjs --check",
    "tauri": "tauri",
    "icons": "tauri icon src-tauri/app-icon.svg",
    "tauri:dev": "npm run icons && tauri dev",
    "tauri:build": "npm run icons && tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-http": "^2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
